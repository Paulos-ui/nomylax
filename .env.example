# ---------------------------------------------------------------
# NOMYLAX ENVIRONMENT
# cp .env.example .env.local
# Never place a secret behind NEXT_PUBLIC_. Anything with that
# prefix is compiled into the browser bundle.
# ---------------------------------------------------------------

# --- Application ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Base ---
# base-sepolia for development and demonstration, base for production.
NEXT_PUBLIC_BASE_NETWORK=base-sepolia
BASE_RPC_URL=https://sepolia.base.org

# --- Authentication ---
# Required. Generate with: openssl rand -hex 32
SESSION_SECRET=

# --- Execution ---
# Required only for live execution. Without it, approved decisions are
# refused rather than faked, and shadow mode still works.
# Use a dedicated account funded with a small amount. Never a personal wallet.
EXECUTOR_PRIVATE_KEY=

# --- Agent integration ---
# Bearer token Nomylax presents to registered agent endpoints.
AGENT_API_KEY=
# Optional. Comma separated hostnames. When set, only these may be contacted.
AGENT_ENDPOINT_ALLOWLIST=

# --- Database ---
# Postgres persistence is in progress. Leave unset to use development storage.
# DATABASE_URL=

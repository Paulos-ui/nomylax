# Public application identity
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_BASE_NETWORK=base-sepolia
NEXT_PUBLIC_RPC_URL=https://sepolia.base.org

# Server-only authentication (generate a long random value)
SESSION_SECRET=

# Groq powers explanation only. Never expose this as NEXT_PUBLIC_*.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Execution: leave unset unless intentionally testing live Base execution.
BASE_RPC_URL=
EXECUTOR_PRIVATE_KEY=

# Registered agent integration
AGENT_API_KEY=
AGENT_ENDPOINT_ALLOWLIST=

# Required by the current production repository boundary. See FINAL_HANDOFF.md.
DATABASE_URL=
